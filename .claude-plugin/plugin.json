{
  "name": "understand-this-video",
  "displayName": "Understand This Video Plugin",
  "description": "Let your AI watch and hear a local video file: key frames, timestamped transcript and a contact sheet, processed locally. This plugin does not download videos from the internet.",
  "version": "1.2.3",
  "author": {
    "name": "Ship Monthly",
    "email": "video@shipmonthly.com"
  },
  "homepage": "https://understandvideo.shipmonthly.com",
  "repository": "https://github.com/africaappstudio-max/video-context-ai-download",
  "license": "SEE LICENSE IN LICENSE",
  "mcpServers": {
    "understand-this-video": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/africaappstudio-max/video-context-ai-download",
        "understand-this-video-mcp"
      ]
    }
  }
}